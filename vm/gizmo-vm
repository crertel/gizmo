#!/usr/bin/env bash
# gizmo-vm — launch a Gizmo agent inside a QEMU VM
#
# Usage: gizmo-vm [gizmo-flags] <frame.txt> [more.txt ...]
#
# No sudo required. Uses QEMU user-mode networking (SLiRP) and 9p shared dirs.

set -euo pipefail

VM_PATH="@VM_PATH@"

# ── Preflight checks ─────────────────────────────────────────────────────────

if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
  echo "ERROR: ANTHROPIC_API_KEY environment variable is not set." >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "Usage: gizmo-vm [gizmo-flags] <frame.txt> [more.txt ...]" >&2
  exit 1
fi

# ── Parse arguments ──────────────────────────────────────────────────────────
# Flags that take a value argument (not a file path)
flags_with_value="--node --cookie --model --max-cycles --watchdog --boot --runtime --dump-runtime --trace-file --bash-timeout --name --init"

gizmo_flags=()
frame_files=()
expect_value=false

for arg in "$@"; do
  if $expect_value; then
    gizmo_flags+=("$arg")
    expect_value=false
  elif [[ "$arg" == -* ]]; then
    gizmo_flags+=("$arg")
    # Check if this flag expects a value argument
    for fv in $flags_with_value; do
      if [[ "$arg" == "$fv" ]]; then
        expect_value=true
        break
      fi
    done
  else
    if [ ! -f "$arg" ]; then
      echo "ERROR: frame file not found: $arg" >&2
      exit 1
    fi
    frame_files+=("$(realpath "$arg")")
  fi
done

if [ ${#frame_files[@]} -eq 0 ]; then
  echo "ERROR: no frame files specified." >&2
  exit 1
fi

# ── Create tmpdir + cleanup trap ─────────────────────────────────────────────

TMPDIR=$(mktemp -d /tmp/gizmo-vm.XXXXXX)
cleanup() {
  # Show output log if it exists
  if [ -f "$TMPDIR/output.log" ]; then
    cat "$TMPDIR/output.log"
  fi
  rm -rf "$TMPDIR"
}
trap cleanup EXIT

mkdir -p "$TMPDIR/frames"

# Copy boot frame files
for f in "${frame_files[@]}"; do
  cp "$f" "$TMPDIR/frames/"
done

# Copy gizmo source tree (for nix builds inside the VM)
# Look for flake.nix in cwd or GIZMO_SRC env var
GIZMO_SRC="${GIZMO_SRC:-$PWD}"
if [ -f "$GIZMO_SRC/flake.nix" ]; then
  mkdir -p "$TMPDIR/src/vm"
  cp "$GIZMO_SRC/flake.nix" "$TMPDIR/src/"
  [ -f "$GIZMO_SRC/flake.lock" ] && cp "$GIZMO_SRC/flake.lock" "$TMPDIR/src/"
  cp "$GIZMO_SRC/gizmo.exs" "$TMPDIR/src/"
  cp "$GIZMO_SRC/vm/configuration.nix" "$TMPDIR/src/vm/"
  # Copy test frames if present
  if [ -d "$GIZMO_SRC/test" ]; then
    cp -r "$GIZMO_SRC/test" "$TMPDIR/src/test"
  fi
fi

# Write env file
{
  echo "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}"
  if [ ${#gizmo_flags[@]} -gt 0 ]; then
    echo "GIZMO_FLAGS=\"${gizmo_flags[*]}\""
  fi
} > "$TMPDIR/.env"
chmod 600 "$TMPDIR/.env"

# ── Launch the VM ─────────────────────────────────────────────────────────────

export SHARED_DIR="$TMPDIR"

# Persist the disk image so Mix.install deps survive across runs
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gizmo-vm"
mkdir -p "$CACHE_DIR"
export NIX_DISK_IMAGE="$CACHE_DIR/gizmo-vm.qcow2"

"$VM_PATH/bin/run-gizmo-vm-vm"
